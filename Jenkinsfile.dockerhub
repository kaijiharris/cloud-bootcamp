pipeline {
    agent any

    environment {
        DOCKER_HUB_CREDENTIALS = credentials('dockerhub-credentials-id')
    }

    stages {
        stage('Checkout') {
            steps {
                git url: 'https://github.com/kaijiharris/cloud-bootcamp.git', branch: 'main'
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('week6-docker') {
                    sh 'docker build -t $DOCKER_HUB_CREDENTIALS_USR/flask-app:${BUILD_NUMBER} -t $DOCKER_HUB_CREDENTIALS_USR/flask-app:latest .'
                }
            }
        }

        stage('Push to Docker Hub') {
            steps {
                sh 'echo $DOCKER_HUB_CREDENTIALS_PSW | docker login -u $DOCKER_HUB_CREDENTIALS_USR --password-stdin'
                sh 'docker push $DOCKER_HUB_CREDENTIALS_USR/flask-app:${BUILD_NUMBER}'
                sh 'docker push $DOCKER_HUB_CREDENTIALS_USR/flask-app:latest'
            }
        }
    }

    post {
        always {
            sh 'docker logout || true'
            cleanWs()
        }
    }
}